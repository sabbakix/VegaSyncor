# Test SMB server for the VegaSyncor end-to-end tests (test/e2e).
# Copy to .env (which is git-ignored), fill it in and keep it private:
#   cp .env.example .env && chmod 600 .env
# The user needs read and write access to both shares; the tests only create
# and remove vs-test* folders in them. Use a dedicated test-only account.
SMB_HOST=192.0.2.10
SMB_USER=testuser
SMB_PASS=change-me
SMB_SHARE_A=share-a
SMB_SHARE_B=share-b

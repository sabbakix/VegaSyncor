[Unit]
Description=VegaSyncor - sincronizzazione cartelle di rete per backup
Documentation=file:///usr/share/doc/vegasyncor/README.md
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/vegasyncor daemon
Restart=on-failure
RestartSec=5
# /run/vegasyncor: socket per la TUI e punti di montaggio temporanei
RuntimeDirectory=vegasyncor
RuntimeDirectoryMode=0755
# /var/lib/vegasyncor: storico e log delle esecuzioni
StateDirectory=vegasyncor
StateDirectoryMode=0750
# /etc/vegasyncor: configurazione e chiave master (solo root)
ConfigurationDirectory=vegasyncor
ConfigurationDirectoryMode=0700
UMask=0027
# all'arresto il servizio interrompe rsync e smonta le condivisioni
KillMode=mixed
TimeoutStopSec=60
# priorità bassa per non rallentare il server durante le copie
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target

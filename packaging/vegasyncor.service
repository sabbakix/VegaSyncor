[Unit]
Description=VegaSyncor - sync of network folders for backup
Documentation=file:///usr/share/doc/vegasyncor/README.md
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/vegasyncor daemon
Restart=on-failure
RestartSec=5
# /run/vegasyncor: socket for the TUI and temporary mount points
RuntimeDirectory=vegasyncor
RuntimeDirectoryMode=0755
# /var/lib/vegasyncor: run history and logs
StateDirectory=vegasyncor
StateDirectoryMode=0750
# /etc/vegasyncor: configuration and master key (root only)
ConfigurationDirectory=vegasyncor
ConfigurationDirectoryMode=0700
UMask=0027
# on stop the service interrupts rsync and unmounts the shares
KillMode=mixed
TimeoutStopSec=60
# low priority so the server is not slowed down during copies
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target

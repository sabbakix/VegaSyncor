#!/bin/sh
set -e
if [ "$1" = "purge" ]; then
    # WARNING: deletes configuration, master key (saved passwords) and history.
    # The backup data in the destinations is NOT touched.
    rm -rf /etc/vegasyncor /var/lib/vegasyncor
    getent group vegasyncor >/dev/null && delgroup --system vegasyncor >/dev/null 2>&1 || true
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi
exit 0
